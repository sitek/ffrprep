<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ title }}</title>
</head>
<body>
    <header class="report-header">
        <h1>{{ title }}</h1>
        <p class="subject-id">Subject: sub-{{ subject }}</p>
    </header>
    <nav id="toc" aria-label="Table of contents">
        <h2>Contents</h2>
        {% if sections %}
        <ul>
            {% for section in sections %}
            <li><a href="#{{ section.id }}">{{ section.title }}</a></li>
            {% endfor %}
        </ul>
        {% else %}
        <p class="toc-empty">No sections rendered.</p>
        {% endif %}
    </nav>
    <main>
        {% for section in sections %}
        <section id="{{ section.id }}" class="report-section">
            <h2>{{ section.title }}</h2>
        </section>
        {% endfor %}
    </main>
</body>
</html>
