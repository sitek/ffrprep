[flake8]
max-line-length = 115
extend-exclude =
    .git,
    .venv,
    build,
    dist,
    docs,
    versioneer.py,
    ffrprep/_version.py
# E203: whitespace before ':' (conflicts with black)
# W503: line break before binary operator (conflicts with black/PEP8 modern guidance)
extend-ignore = E203, W503
